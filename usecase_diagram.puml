@startuml Kwork Bot Use Cases
!define DIRECTION top to bottom
skinparam backgroundColor #FEFEFE
skinparam handwritten false
skinparam actorBackgroundColor #FFE4C4
skinparam actorBorderColor #8B4513
skinparam usecaseBackgroundColor #E1F5FE
skinparam usecaseBorderColor #01579B

actor "👤 Kwork User" as kwork_user
actor "👨‍💼 Manager" as manager
actor "⚙️ Admin" as admin

rectangle "🤖 Kwork Bot System" {
  usecase "View Messages\n(Просмотр сообщений)" as uc1
  usecase "Check Dialogs\n(Проверка диалогов)" as uc2
  usecase "Send Message\n(Отправка сообщения)" as uc3
  usecase "Create Chat Topic\n(Создание топика)" as uc4
  usecase "Process Message (AI)\n(Обработка ИИ)" as uc5
  usecase "Process Message (Manager)\n(Обработка менеджером)" as uc6
  usecase "Handle Files\n(Работа с файлами)" as uc7
  usecase "Generate AI Response\n(Генерация ответа GPT)" as uc8
  usecase "Manage ManagerMode\n(Управление режимом)" as uc9
  usecase "Check Notifications\n(Проверка уведомлений)" as uc10
  usecase "Forward to Telegram\n(Пересылка в TG)" as uc11
  usecase "View Chat History\n(История чата)" as uc12
  usecase "Extract Text from Files\n(Извлечение текста)" as uc13
  usecase "Set Message Reaction\n(Отметить прочитанным)" as uc14
}

' Kwork User interactions
kwork_user --> uc1 : initiates
kwork_user --> uc2 : views
kwork_user --> uc3 : sends

' Manager interactions
manager --> uc6 : handles
manager --> uc12 : checks
manager --> uc9 : controls

' Admin interactions
admin --> uc4 : creates

' Internal dependencies
uc2 --> uc10 : checks for
uc1 .down.|> uc2 : includes
uc2 .down.|> uc5 : triggers
uc2 .down.|> uc6 : triggers

uc5 .down.|> uc7 : uses
uc5 .down.|> uc8 : calls
uc5 .down.|> uc11 : sends via

uc6 .down.|> uc7 : uses
uc6 .down.|> uc11 : sends via

uc7 .down.|> uc13 : processes

uc8 --> uc3 : uses to
uc3 .down.|> uc11 : sends through

uc11 .down.|> uc14 : marks as

uc10 .up.|> uc9 : updates

@enduml
